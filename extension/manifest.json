{
  "manifest_version": 3,
  "name": "Glean Response Assistant",
  "description": "Draft responses from visible web context using a local Glean integration.",
  "version": "0.1.15",
  "key": "",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "draft-reply": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Draft a response from the current page with Glean"
    }
  },
  "options_page": "options.html"
}
